/*Training Exercises*/
BISTABLE = (trigger -> ONE),
ONE      = ([1] -> trigger -> ZERO),
ZERO     = ([0] -> trigger -> ONE).

/* museum */
const N = 5
EAST = (arrive -> EAST).
WEST = (leave -> WEST).
DIRECTOR = (open -> close -> DIRECTOR).
CONTROL = CLOSED[0],
CLOSED[i:0..N] = (when (i==0) open -> OPENED[...]
    |when (...) leave -> CLOSED[...]
    ),
OPENED[i:0..N] = (close -> CLOSED[i]
    |... arrive -> OPENED[...]
    |... leave -> OPENED[...]
    ).
||MUSEUM = (EAST || WEST || DIRECTOR || CONTROL).


/* Time-Out Client Server */

/* (a) */
CLIENT = (call -> WAIT),
WAIT   = (answer -> continue -> CLIENT | timeout -> CLIENT).

SERVER = (request -> service -> reply -> SERVER).

||CLIENT_SERVER = (CLIENT || SERVER) /{call/request, answer/reply}.


/* (b) */
/*
There is a posible deadlock with state 3. It can be reached by call->service->timeout or call->timeout->service but there are no outgoing transitions.
*/

/* (c) */
SERVER2 = (request -> (service -> (reply -> SERVER|timeout -> SERVER)|timeout -> SERVER)).


